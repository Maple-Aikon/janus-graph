# Janus-Graph Environment Variables (Overrides config.yaml)

# Engine
JANUS_ENGINE_HOST=127.0.0.1
JANUS_ENGINE_PORT=6379

# Graphiti Core & LLM
JANUS_GRAPHITI_GROUP_ID=picoclaw_memory
JANUS_GRAPHITI_LLM_API_KEY=sk-litellm-proxy
JANUS_GRAPHITI_LLM_BASE_URL=http://127.0.0.1:4000/v1
JANUS_GRAPHITI_LLM_MODEL=claude-3-5-sonnet-20241022
JANUS_GRAPHITI_EMBEDDING_BASE_URL=http://127.0.0.1:8081/v1

# Pipeline
JANUS_PIPELINE_CONCURRENCY=6
JANUS_PIPELINE_CRON_INTERVAL_MIN=10
JANUS_PIPELINE_DREAM_HOUR=2
JANUS_PIPELINE_DREAM_MINUTE=30

# Telegram Reporting
JANUS_TELEGRAM_BOT_TOKEN=
JANUS_TELEGRAM_CHAT_ID=
